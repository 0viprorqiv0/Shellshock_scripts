# 1. Detect ICMP Echo Request (Ping) - Referenced from line 97 in snort_rule.txt
alert icmp any any -> $HOME_NET any (msg:"[IDS ALERT] ICMP Ping Request Detected"; itype:8; sid:1000001; rev:1;)

# 2. Detect Nmap TCP SYN Port Scan - Referenced from lines 88/109 in snort_rule.txt
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"[IDS ALERT] TCP SYN Port Scan Detected"; flags:S; threshold:type threshold, track by_src, count 20, seconds 5; sid:1000002; rev:1;)

# 3. Detect Web HTTP GET Request - Referenced from line 72 in snort_rule.txt
alert tcp any any -> 172.16.1.10 80 (msg:"[IDS ALERT] HTTP GET Request to Web Server"; flow:to_server,established; content:"GET"; sid:1000003; rev:1;)

# 4. Detect Inbound SSH Connection to Server - Referenced from line 103 in snort_rule.txt
alert tcp $EXTERNAL_NET any -> 172.16.1.10 22 (msg:"[IDS ALERT] Incoming SSH Connection!"; flags:S; sid:1000004; rev:1;)

# 5. Detect Shellshock (CVE-2014-6271) Injection Attempt - Using flow and relative content modifiers
alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"[IDS ALERT] GNU Bash Shellshock Injection Attempt"; flow:to_server,established; content:"() {"; nocase; content:":\;}\;"; distance:0; within:10; sid:1000041; rev:1;)

# 6. Detect Outbound Reverse Shell Connection Attempt (TCP SYN to Port 4444)
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444 (msg:"[IDS ALERT] Outbound Reverse Shell Connection Attempt (TCP SYN)"; flags:S; flow:to_server; sid:1000042; rev:1;)

# 7. Detect Established Outbound Reverse Shell Session (Port 4444)
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444 (msg:"[IDS ALERT] Established Outbound Reverse Shell Session"; flow:established,to_server; sid:1000043; rev:1;)
